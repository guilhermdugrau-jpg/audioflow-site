# Cloudflare Pages Headers for Performance

# Cache static assets aggressively
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML - short cache, revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Security headers
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: clipboard-read=(self), clipboard-write=(self), accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

# HSTS (uncomment after verifying HTTPS works)
# /*
#   Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Enable Brotli/Gzip compression (Cloudflare does this automatically)
# No config needed - Cloudflare handles it